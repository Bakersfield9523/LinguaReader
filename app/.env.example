# 环境变量配置（复制此文件为 .env 并填入真实值）
# 注意：.env 文件已被加入 .gitignore，不会被提交

APP_ID=your-app-id-here
APP_SECRET=your-app-secret-here

VITE_APP_ID=your-app-id-here

# 数据库
# - 单机模式（默认）：填本地路径，如 file:./data/lingua.db
# - 云同步模式：填 libsql:// 开头的 Turso 数据库地址，并填写下方 TURSO_AUTH_TOKEN，
#   即可实现账户 + 阅读数据跨设备同步。二者只需二选一，留空本地路径则使用本地 SQLite。
DATABASE_URL=file:./data/lingua.db
TURSO_AUTH_TOKEN=

# Merriam-Webster 词典 API Key（复制本文件为 .env 并填入真实值）
VITE_MW_API_KEY=
